local loadingAttempt = false
local function restoreButtons()
    if loadButton and loadButton.Parent then
        loadButton.Active = true
        loadButton.Text = "Load Script With Key"
    end
    if getKeyButton and getKeyButton.Parent then getKeyButton.Active = true end
    loadingAttempt = false
end

local function startProtectedScript(rawKey, fromSavedKey)
    if loadingAttempt then return end
    local key = tostring(rawKey or ""):gsub("%s+", "")
    if key == "" then
        setStatus("Paste your Jnkie key before loading.", COLORS.error)
        return
    end
    if type(getgenv) ~= "function" then
        setStatus("This executor does not expose getgenv(), required by the Jnkie loader.", COLORS.error)
        return
    end
    local envOk, env = pcall(getgenv)
    if not envOk or type(env) ~= "table" then
        setStatus("Could not access the executor environment for Jnkie authentication.", COLORS.error)
        return
    end

    loadingAttempt = true
    local keySaved = saveKeyToFolder(key)
    env.SCRIPT_KEY = key
    local runToken = tostring(os.time()) .. "-" .. tostring(math.floor(os.clock() * 1000000)) .. "-" .. tostring(math.random(100000, 999999))
    env.LEXUSHUB_LOADER_RUN_ID = runToken
    env.LEXUSHUB_PROTECTED_BOOT_RUN_ID = nil
    loadButton.Active = false
    loadButton.Text = fromSavedKey and "Checking Saved Key..." or "Loading..."
    getKeyButton.Active = false
    if fromSavedKey then
        setStatus("Checking your saved key with Jnkie...", COLORS.muted)
    elseif keySaved then
        setStatus("Key saved in the workspace root; submitting to Jnkie...", COLORS.muted)
    else
        setStatus("Submitting to Jnkie; file storage is unavailable in this executor.", COLORS.muted)
    end

    task.spawn(function()
        local callFinished = false
        local callOk, callError
        task.spawn(function()
            callOk, callError = pcall(function() Junkie.load_script() end)
            callFinished = true
        end)

        local startedAt = os.clock()
        local returnedAt
        while gui and gui.Parent and os.clock() - startedAt < 45 do
            if env.LEXUSHUB_PROTECTED_BOOT_RUN_ID == runToken then
                setStatus("Key accepted. Opening Lexushub...", COLORS.success)
                task.wait(0.15)
                if gui and gui.Parent then gui:Destroy() end
                return
            end
            if callFinished then
                returnedAt = returnedAt or os.clock()
                if os.clock() - returnedAt >= 0.75 then
                    local failureMessage
                    local invalidKey = false
                    if not callOk then
                        local errorText = tostring(callError)
                        local lowerError = string.lower(errorText)
                        invalidKey = string.find(lowerError, "key_invalid", 1, true) ~= nil
                            or string.find(lowerError, "invalid key", 1, true) ~= nil
                            or string.find(lowerError, "not valid", 1, true) ~= nil
                        failureMessage = invalidKey
                            and "Jnkie rejected this key as invalid. Replace it with a new key."
                            or ("Jnkie loader error: " .. errorText)
                    else
                        failureMessage = "Jnkie did not start the protected source. The key may be invalid or access may be denied."
                    end
                    setStatus(failureMessage, COLORS.error)
                    notify(invalidKey and "This key is invalid. Replace it and try again." or "Key check failed; no protected script startup was confirmed.")
                    restoreButtons()
                    return
                end
            end
            task.wait(0.1)
        end
        if gui and gui.Parent and loadingAttempt then
            setStatus("Timed out waiting for Jnkie to start the protected source. You can retry.", COLORS.error)
            notify("Key check timed out; no successful script startup was confirmed.")
            restoreButtons()
        end
    end)
end

