local function setStatus(text, color)
    if status and status.Parent then
        status.Text = tostring(text or "")
        status.TextColor3 = color or COLORS.muted
    end
end

local function safeClipboard(text)
    if type(setclipboard) == "function" then
        local ok = pcall(setclipboard, text)
        return ok
    end
    return false
end

local sdkOk, Junkie = pcall(function()
    local httpGet = game.HttpGet
    if type(loadstring) ~= "function" or type(httpGet) ~= "function" then
        error("This loader requires an executor with HttpGet and loadstring support.")
    end
    return loadstring(game:HttpGet(SDK_URL))()
end)
if not sdkOk or type(Junkie) ~= "table" then
    setStatus("Could not initialize Jnkie SDK: " .. tostring(Junkie), COLORS.error)
    getKeyButton.Active = false
    loadButton.Active = false
    return
end

