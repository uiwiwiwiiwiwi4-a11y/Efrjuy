getKeyButton.Activated:Connect(function()
    getKeyButton.Active = false
    getKeyButton.Text = "Requesting..."
    setStatus("Requesting a key link from Jnkie...", COLORS.muted)
    task.spawn(function()
        local callOk, link, err = pcall(Junkie.get_key_link)
        getKeyButton.Active = true
        getKeyButton.Text = "Get Key Link"
        if not callOk then
            setStatus("Could not request a link: " .. tostring(link), COLORS.error)
            return
        end
        if type(link) ~= "string" or link == "" then
            setStatus("Jnkie did not return a key link: " .. tostring(err or "try again"), COLORS.error)
            return
        end
        keyLinkBox.Text = link
        local copied = safeClipboard(link)
        setStatus(copied and "Key link copied. Open it, complete the key steps, then paste your key above." or "Key link is shown below. Copy it, complete the key steps, then paste your key above.", COLORS.success)
    end)
end)

loadButton.Activated:Connect(function()
    local key = tostring(keyBox.Text or ""):gsub("%s+", "")
    if key == "" then
        setStatus("Paste your Jnkie key before loading.", COLORS.error)
        return
    end
    if type(getgenv) ~= "function" then
        setStatus("This executor does not expose getgenv(), required by the Jnkie loader.", COLORS.error)
        return
    end
    local envOk, env = pcall(getgenv)
    if not envOk or type(env) ~= "table" then
        setStatus("Could not access the executor environment for Jnkie authentication.", COLORS.error)
        return
    end
    env.SCRIPT_KEY = key
    local keySaved = saveKeyToFolder(key)
    loadButton.Active = false
    loadButton.Text = "Loading..."
    getKeyButton.Active = false
    setStatus(keySaved and "Key saved in the workspace root; submitting to Jnkie..." or "Submitting to Jnkie; file storage is unavailable in this executor.", COLORS.muted)
    task.spawn(function()
        local callOk, err = pcall(function()
            Junkie.load_script()
        end)
        if not callOk then
            loadButton.Active = true
            loadButton.Text = "Load Script With Key"
            getKeyButton.Active = true
            setStatus("Jnkie loader error: " .. tostring(err), COLORS.error)
            return
        end
        setStatus("Jnkie loader call completed. If the Lexushub window opened, close this loader with ×.", COLORS.success)
        loadButton.Active = true
        loadButton.Text = "Load Script With Key"
        getKeyButton.Active = true
    end)
end)
