local function readKeyFile(path)
    if type(readfile) ~= "function" then return nil end
    local ok, value = pcall(readfile, path)
    if not ok or type(value) ~= "string" then return nil end
    value = value:gsub("^%s+", ""):gsub("%s+$", "")
    return value ~= "" and value or nil
end

local function saveKeyToFolder(key)
    if type(writefile) ~= "function" then return false end
    local ok = pcall(writefile, KEY_FILE, tostring(key or ""))
    return ok
end

local function loadSavedKey()
    local saved = readKeyFile(KEY_FILE)
    if saved then return saved end
    -- Migrate keys saved by an earlier loader inside LxBuildStorage.
    local legacy = readKeyFile(LEGACY_KEY_FILE)
    if legacy then saveKeyToFolder(legacy); return legacy end
    return nil
end

